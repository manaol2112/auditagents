{
  "name": "soxplan-web",
  "version": "0.1.0",
  "private": true,
  "description": "Planning Workforce web UI: sidebar + workspace over the read-only workspace API. Secure by design: strict CSP, Trusted Types, validated API responses, no browser storage of audit data.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/security-check.mjs --dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "security": "node scripts/security-check.mjs",
    "check": "npm run typecheck && npm run security && npm run contrast && npm test",
    "audit": "npm audit --audit-level=moderate",
    "contrast": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
